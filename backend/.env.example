# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is ignored by git. Never commit real keys.

# Cloud model keys (keep these secret)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Which model runs each tier. Free models change often: if one disappears,
# pick another from the provider's website and edit the name here.
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Local model (Ollama is not installed yet; leave OLLAMA_MODEL empty until it is)
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Services started by Docker (docker/docker-compose.yml). These values match it: keep them.
# The database is on port 5433 because a PostgreSQL installed on Windows already uses 5432.
DATABASE_URL=postgresql+psycopg://synoras:synoras_password@127.0.0.1:5433/synoras
REDIS_URL=redis://127.0.0.1:6379/0

# The website (frontend) address. Only this address may call the API from a browser (CORS).
FRONTEND_ORIGIN=http://localhost:3000

# Login tokens. JWT_SECRET must be at least 32 random characters and kept private.
# Make one with:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Every computer should use its own secret.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
