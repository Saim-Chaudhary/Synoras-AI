# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is ignored by git. Never commit real keys.

# Cloud model keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Model names for the key check (copy a current model name from each provider's website)
GROQ_TEST_MODEL=
OPENROUTER_TEST_MODEL=

# Services started by Docker later (these defaults are fine for now)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/synoras
REDIS_URL=redis://localhost:6379/0

# Used by the Login step later. Any long random text for now.
JWT_SECRET=
